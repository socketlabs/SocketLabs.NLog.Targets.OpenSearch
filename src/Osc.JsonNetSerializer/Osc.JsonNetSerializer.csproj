<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>OSC.JsonNetSerializer</PackageId>
		<Title>OSC.JsonNetSerializer - OpenSearch .NET custom Json.NET serializer</Title>
		<PackageTags>opensearch,opensearch,search,lucene,osc,serializer,json</PackageTags>
		<Description>OSC uses an internal serializer. This package enables serialization for your documents using your own custom Json.NET serializer</Description>
	</PropertyGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<TargetFrameworks>netstandard2.0;net461</TargetFrameworks>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Osc" Version="1.0.0" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
	</ItemGroup>
</Project>