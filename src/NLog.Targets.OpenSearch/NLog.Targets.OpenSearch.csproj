<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net461;net48;net5.0;net6.0</TargetFrameworks>
    <Company>SocketLabs</Company>
    <Description>NLog Target for OpenSearch</Description>
    <Copyright>2022 SocketLabs Acquisition LLC</Copyright>
    <PackageProjectUrl>https://github.com/socketlabs/NLog.Targets.OpenSearch</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/socketlabs/NLog.Targets.OpenSearch</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>opensearch,nlog</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="4.7.13" />
    <PackageReference Include="Osc" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Osc.JsonNetSerializer\Osc.JsonNetSerializer.csproj" />
  </ItemGroup>

</Project>
