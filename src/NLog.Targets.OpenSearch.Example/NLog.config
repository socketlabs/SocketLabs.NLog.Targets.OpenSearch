<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
			xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
			autoReload="true"
			throwExceptions="false"
			internalLogLevel="Warn" internalLogFile="logs\nlog-internal.log">

	<extensions>
		<add assembly="NLog.Targets.OpenSearch"/>
	</extensions>
	
	<targets>
		<target name="opensearch" xsi:type="BufferingWrapper" flushTimeout="1000">
			
			<target xsi:type="OpenSearch"
					uris="https://localhost:9200/"
					username="logstash"
					password="logstash"
					index="nlog-selfservice-${date:format=yyyy.MM.dd}"
					retryCount ="10"
					batchSize="10"
					includeEventProperties="true"
					includeCallSite="true"
					IncludeCallSiteStackTrace="false"
					enableHttpCompression="true">

				<contextproperty name="hostname" layout="${hostname}" />
				<contextproperty name="threadId" layout="${threadid}" />
				<contextproperty name="assemblyVersion" layout="${assembly-version}" />
				<contextproperty name="gc.collectionCount0" layout="${gc:property=CollectionCount0}" />
				<contextproperty name="gc.collectionCount1" layout="${gc:property=CollectionCount1}" />
				<contextproperty name="gc.collectionCount2" layout="${gc:property=CollectionCount2}" />
				<contextproperty name="gc.maxGeneration" layout="${gc:property=MaxGeneration}" />
				<contextproperty name="gc.totalMemory" layout="${gc:property=TotalMemory}" />
				<contextproperty name="gc.totalMemoryForceCollection" layout="${gc:property=TotalMemoryForceCollection}" />
				<contextproperty name="processInfo.pid" layout="${processinfo:property=Id}" />
				<contextproperty name="processInfo.handleCount" layout="${processinfo:property=HandleCount}" />
				<contextproperty name="processInfo.maxWorkingSet" layout="${processinfo:property=MaxWorkingSet}" />
				<contextproperty name="processInfo.minWorkingSet" layout="${processinfo:property=MinWorkingSet}" />
				<contextproperty name="processInfo.peakWorkingSet64" layout="${processinfo:property=PeakWorkingSet64}" />
				<contextproperty name="processInfo.privateMemorySize64" layout="${processinfo:property=PrivateMemorySize64}" />
				<contextproperty name="processInfo.startTime" layout="${processinfo:property=StartTime}" />
				<contextproperty name="processInfo.virtualMemorySize64" layout="${processinfo:property=VirtualMemorySize64}" />
				<contextproperty name="processInfo.workingSet64" layout="${processinfo:property=WorkingSet64}" />
				<contextproperty name="processName" layout="${processname}" />
				<contextproperty name="aspNetEnvironment" layout="${aspnet-environment}" />
				<contextproperty name="dotnetVersion" layout="${environment:DOTNET_VERSION}" />
				<contextproperty name="appDomain" layout="${appdomain:format={1\}}" />
			</target>
		</target>
	</targets>
	
	<rules>
		<logger name="*" minlevel="Info" writeTo="opensearch" />
	</rules>
</nlog>