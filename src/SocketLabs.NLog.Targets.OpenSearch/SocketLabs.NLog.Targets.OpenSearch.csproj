<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Company>SocketLabs</Company>
		<Description>NLog Target for OpenSearch</Description>
		<Copyright>© 2025 SocketLabs Acquisition, LLC. All rights reserved.</Copyright>
		<Authors>Matt Soler</Authors>
		<PackageTags>opensearch,nlog,target,logging</PackageTags>
		<PackageProjectUrl>https://github.com/socketlabs/SocketLabs.NLog.Targets.OpenSearch</PackageProjectUrl>
		<RepositoryUrl>https://github.com/socketlabs/SocketLabs.NLog.Targets.OpenSearch</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
		<FileVersion>2.0.0.0</FileVersion>
		<LangVersion>Latest</LangVersion>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Converters\RouteEndpointConverter.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\icon.png">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\LICENSE.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.Text.Json" Version="8.0.6" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
		<PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
		<PackageReference Include="NLog" Version="6.1.0" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>SocketLabs.NLog.Targets.OpenSearchTests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

</Project>
