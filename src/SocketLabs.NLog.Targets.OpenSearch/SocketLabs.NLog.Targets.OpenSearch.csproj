<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net6.0;net7.0;net8.0;net9.0;</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Company>SocketLabs</Company>
		<Description>NLog Target for OpenSearch</Description>
		<Copyright>© 2025 SocketLabs Acquisition, LLC. All rights reserved.</Copyright>
		<Authors>Matt Soler</Authors>
		<PackageTags>opensearch,nlog,target,logging</PackageTags>
		<PackageProjectUrl>https://github.com/socketlabs/SocketLabs.NLog.Targets.OpenSearch</PackageProjectUrl>
		<RepositoryUrl>https://github.com/socketlabs/SocketLabs.NLog.Targets.OpenSearch</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
		<FileVersion>2.0.0.0</FileVersion>
		<LangVersion>Latest</LangVersion>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Converters\RouteEndpointConverter.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\icon.png">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\LICENSE.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net461'">
		<PackageReference Include="System.Text.Json" Version="6.0.11" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' != 'net461'">
		<PackageReference Include="System.Text.Json" Version="9.0.10" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.10" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net6.0' OR '$(TargetFramework)' == 'net7.0' OR '$(TargetFramework)' == 'net8.0' OR '$(TargetFramework)' == 'net9.0'">
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
		<PackageReference Include="NLog" Version="6.0.6" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>SocketLabs.NLog.Targets.OpenSearchTests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

</Project>
